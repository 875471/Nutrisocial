// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            Int        @id @default(autoincrement())
  email         String     @unique
  password      String
  name          String
  createdAt     DateTime   @default(now())
  // Datos de perfil para el objetivo calórico (ver src/nutrition/calorieGoal.js). Opcionales:
  // un usuario recién registrado todavía no los ha rellenado.
  birthDate     DateTime?
  heightCm      Float?
  weightKg      Float?
  // "M" o "F"
  sex           String?
  // "sedentario" | "ligero" | "moderado" | "activo" | "muy_activo"
  activityLevel String?
  // "perder_peso" | "mantener" | "ganar_peso"
  goal          String?
  recipes       Recipe[]
  logEntries    LogEntry[]
}

model Recipe {
  id               Int                @id @default(autoincrement())
  title            String
  // SQLite no tiene tipo lista: los pasos se guardan como JSON serializado (array de strings)
  steps            String
  servings         Int
  prepMinutes      Int?
  // Totales de la receta completa, calculados al crearla a partir de sus ingredientes
  kcal             Float              @default(0)
  protein          Float              @default(0)
  carbs            Float              @default(0)
  fat              Float              @default(0)
  // Peso en crudo de los ingredientes con peso conocido; null si no se pudo estimar ninguno
  totalWeightGrams Float?
  authorId         Int
  author           User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  ingredients      RecipeIngredient[]
  logEntries       LogEntry[]
  createdAt        DateTime           @default(now())

  @@index([authorId])
}

// Alimento de referencia con sus valores por 100 g. Se carga desde
// data/bedca_foods.json con `npx prisma db seed` (ver prisma/seed.js).
model Food {
  id          Int                @id @default(autoincrement())
  name        String             @unique
  kcal        Float
  protein     Float
  carbs       Float
  fat         Float
  source      String             @default("BEDCA")
  ingredients RecipeIngredient[]
  logEntries  LogEntry[]
}

model RecipeIngredient {
  id       Int     @id @default(autoincrement())
  recipeId Int
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  position Int
  // Nombre tal como lo escribió el usuario
  name     String
  quantity Float?
  unit     String?
  // Peso estimado en gramos; null si no se pudo convertir la unidad
  grams    Float?
  // Alimento de la tabla Food asociado; null si no se encontró ninguno
  foodId   Int?
  food     Food?   @relation(fields: [foodId], references: [id], onDelete: SetNull)

  @@index([recipeId])
}

// Entrada del registro nutricional diario: una receta (recipeId + servings) o un alimento
// suelto (foodId + grams). Los valores nutricionales y el nombre se copian al crearla, para
// que el histórico no cambie si después se modifica o se borra la receta.
model LogEntry {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Solo importa el día: se guarda a las 00:00 UTC del día que indica el cliente
  date      DateTime
  // Nombre de la receta o del alimento en el momento de registrarlo
  name      String
  recipeId  Int?
  recipe    Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  foodId    Int?
  food      Food?    @relation(fields: [foodId], references: [id], onDelete: SetNull)
  // Si es una receta: número de raciones consumidas
  servings  Float?
  // Si es un alimento suelto: gramos consumidos
  grams     Float?
  kcal      Float
  protein   Float
  carbs     Float
  fat       Float
  createdAt DateTime @default(now())

  @@index([userId, date])
}
