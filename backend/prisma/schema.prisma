// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                        Int          @id @default(autoincrement())
  email                     String       @unique
  password                  String
  name                      String
  createdAt                 DateTime     @default(now())
  // Datos de perfil para el objetivo calórico (ver src/nutrition/calorieGoal.js). Opcionales:
  // un usuario recién registrado todavía no los ha rellenado.
  birthDate                 DateTime?
  heightCm                  Float?
  weightKg                  Float?
  // "M" o "F"
  sex                       String?
  // "sedentario" | "ligero" | "moderado" | "activo" | "muy_activo"
  activityLevel             String?
  // "perder_peso" | "mantener" | "ganar_peso"
  goal                      String?
  // Verificación del email (ver src/routes/auth.js). Los tokens se guardan hasheados
  // (SHA-256): el enlace o el código que recibe el usuario no está en la base de datos.
  emailVerified             Boolean      @default(false)
  verificationTokenHash     String?      @unique
  verificationTokenExpires  DateTime?
  // Recuperación de contraseña: código de un solo uso con caducidad corta.
  passwordResetTokenHash    String?      @unique
  passwordResetTokenExpires DateTime?
  recipes                   Recipe[]
  logEntries                LogEntry[]
  pantryItems               PantryItem[]
  recipeLikes               RecipeLike[]
}

model Recipe {
  id               Int                @id @default(autoincrement())
  title            String
  // SQLite no tiene tipo lista: los pasos se guardan como JSON serializado (array de strings)
  steps            String
  servings         Int
  prepMinutes      Int?
  // Totales de la receta completa, calculados al crearla a partir de sus ingredientes
  kcal             Float              @default(0)
  protein          Float              @default(0)
  carbs            Float              @default(0)
  fat              Float              @default(0)
  // Peso en crudo de los ingredientes con peso conocido; null si no se pudo estimar ninguno
  totalWeightGrams Float?
  // Foto de la receta: JPEG comprimido en el móvil y guardado en Base64, sin el prefijo
  // "data:". Render (plan gratuito) no tiene disco persistente para guardarla como archivo.
  imageBase64      String?            @db.Text
  authorId         Int
  author           User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  ingredients      RecipeIngredient[]
  logEntries       LogEntry[]
  likes            RecipeLike[]
  createdAt        DateTime           @default(now())

  @@index([authorId])
}

// Alimento de referencia con sus valores por 100 g. Se carga desde
// data/bedca_foods.json con `npx prisma db seed` (ver prisma/seed.js).
model Food {
  id          Int                @id @default(autoincrement())
  name        String             @unique
  kcal        Float
  protein     Float
  carbs       Float
  fat         Float
  source      String             @default("BEDCA")
  ingredients RecipeIngredient[]
  logEntries  LogEntry[]
  pantryItems PantryItem[]
}

model RecipeIngredient {
  id       Int     @id @default(autoincrement())
  recipeId Int
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  position Int
  // Nombre tal como lo escribió el usuario
  name     String
  quantity Float?
  unit     String?
  // Peso estimado en gramos; null si no se pudo convertir la unidad
  grams    Float?
  // Alimento de la tabla Food asociado; null si no se encontró ninguno
  foodId   Int?
  food     Food?   @relation(fields: [foodId], references: [id], onDelete: SetNull)

  @@index([recipeId])
}

// Entrada del registro nutricional diario: una receta (recipeId + servings) o un alimento
// suelto (foodId + grams). Los valores nutricionales y el nombre se copian al crearla, para
// que el histórico no cambie si después se modifica o se borra la receta.
model LogEntry {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Solo importa el día: se guarda a las 00:00 UTC del día que indica el cliente
  date      DateTime
  // Nombre de la receta o del alimento en el momento de registrarlo
  name      String
  recipeId  Int?
  recipe    Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  foodId    Int?
  food      Food?    @relation(fields: [foodId], references: [id], onDelete: SetNull)
  // Si es una receta: número de raciones consumidas
  servings  Float?
  // Si es un alimento suelto: gramos consumidos
  grams     Float?
  kcal      Float
  protein   Float
  carbs     Float
  fat       Float
  createdAt DateTime @default(now())

  @@index([userId, date])
}

// Ingrediente que el usuario tiene en casa, para buscar recetas que puede cocinar
// (ver src/nutrition/pantryMatch.js).
model PantryItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Nombre tal como lo escribió el usuario
  name      String
  // Alimento de la tabla Food asociado, si se encontró uno (igual que en RecipeIngredient)
  foodId    Int?
  food      Food?    @relation(fields: [foodId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

// "Me gusta" de un usuario a una receta del feed. Como mucho uno por usuario y receta.
model RecipeLike {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId  Int
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, recipeId])
  @@index([recipeId])
}
