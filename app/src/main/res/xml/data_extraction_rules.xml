<?xml version="1.0" encoding="utf-8"?>
<!--
   Copia de seguridad (Android 12+). Se copia todo menos la sesión: el archivo de DataStore guarda
   el token JWT, y restaurarlo en otro dispositivo daría la sesión abierta a quien lo restaure
   (OWASP API2, ver docs/memoria/36-checklist-seguridad.md). Tras restaurar, se inicia sesión de nuevo.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
