<?xml version="1.0" encoding="utf-8"?>
<!-- Icono de NutriSocial: un plato visto desde arriba con una hoja encima, en los colores
     del tema (crema, verde hoja y verde claro). Todo dentro de la zona segura de 66 dp
     del icono adaptativo (de 21 a 87), para que ninguna máscara lo recorte. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Plato: borde crema y fondo algo más oscuro. -->
    <path
        android:fillColor="#FAF6EF"
        android:pathData="M26,54a28,28 0,1 1,56 0a28,28 0,1 1,-56 0z" />
    <path
        android:fillColor="#ECE4D6"
        android:pathData="M33,54a21,21 0,1 1,42 0a21,21 0,1 1,-42 0z" />
    <!-- Hoja, en diagonal. -->
    <path
        android:fillColor="#2E7D32"
        android:pathData="M40,68C40,52 50,40 68,40C68,58 56,68 40,68z" />
    <!-- Nervio central de la hoja. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#B9EBB2"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:pathData="M42,66L62,46" />
</vector>
